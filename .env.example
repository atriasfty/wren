# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# OpenRouter API (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large-2411

# Exa (https://exa.ai/), powers web search and image search
EXA_API_KEY=

# Postgres (one DB, all tables tenant-scoped)
DATABASE_URL=postgresql://user:password@host:port/db

# AES-256-GCM key for encrypting per-tenant secrets (ERLC server key, POW token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRET_ENC_KEY=

# REST API listen port
API_PORT=4167

# Polar.sh Billing & Subscriptions
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_CORE_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# Atria Staff Discord IDs (comma-separated, used for global commands)
ATRIA_STAFF_IDS=

# Authenticates Prometheus's GET /metrics scrape (Authorization: Bearer <secret>).
# Blank disables the endpoint (returns 401). Generate the same way as TENANT_SECRET_ENC_KEY.
WREN_METRICS_SECRET=

# Polar discount for small-server checkouts (defaults to Atria's own ID — override)
POLAR_SMALL_SERVER_DISCOUNT_ID=

# ERLC / PRC integration
PRC_GLOBAL_KEY=
PRC_BASE_URL=https://api.erlc.gg/v2
# IP server owners whitelist in ERLC — set to YOUR instance's egress IP
WREN_EGRESS_IP=

# Bloxlink (Discord <-> Roblox account linking)
BLOXLINK_API_KEY=
BLOXLINK_BASE_URL=https://api.blox.link

# Observability (OpenTelemetry). WREN_TRACE_CONTENT=1 exports full prompts on spans.
POSTHOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
WREN_TRACE_CONTENT=