# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# OpenRouter API (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large-2411

# Brave Search (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Postgres (one DB, all tables tenant-scoped)
DATABASE_URL=postgresql://user:password@host:port/db

# AES-256-GCM key for encrypting per-tenant secrets (ERLC server key, POW token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRET_ENC_KEY=

# REST API listen port
API_PORT=4167

# Polar.sh Billing & Subscriptions
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_CORE_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# Atria Staff Discord IDs (comma-separated, used for global commands)
ATRIA_STAFF_IDS=

# Authenticates Prometheus's GET /metrics scrape (Authorization: Bearer <secret>).
# Blank disables the endpoint (returns 401). Generate the same way as TENANT_SECRET_ENC_KEY.
WREN_METRICS_SECRET=